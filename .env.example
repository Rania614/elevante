# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elevante?schema=public"

# Signs the session cookie. Generate with:  openssl rand -base64 32
SESSION_SECRET="replace-with-32+-random-characters"

# 32-byte key (base64) for encrypting national IDs. Generate with:  openssl rand -base64 32
# Changing it later makes stored IDs unreadable.
NATIONAL_ID_KEY="replace-with-base64-32-bytes"

# Where private KYC uploads are stored (outside /public)
STORAGE_DIR="./storage"

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@elevante.local"
ADMIN_PASSWORD="change-me-strong-password"

# Development only: show the OTP on the verify page instead of sending an SMS.
# Must be "false" (or removed) in production.
DEV_SHOW_OTP="true"
